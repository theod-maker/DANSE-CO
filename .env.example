NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/XXXXXXXX
NEXT_PUBLIC_SITE_URL=https://ton-domaine.fr
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# CMS maison (milestone v2.0) — base Neon
# Deux projets Neon distincts : un pour le developpement, un pour la production.
# La valeur locale se met dans .env.local uniquement, jamais dans ce fichier.
# En production, la variable ne sera ajoutee sur Vercel qu'a la phase 18.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signature des sessions admin. Generer une valeur aleatoire d'au moins 32 octets :
#   openssl rand -base64 48
# Changer cette valeur invalide toutes les sessions en cours.
AUTH_SECRET=remplacer-par-une-valeur-aleatoire-de-32-octets-minimum

# Source du contenu des pages publiques.
#   (vide ou absent) = lecture depuis src/lib/fallbackContent.ts, comportement actuel
#   database         = lecture depuis la base
# Se change sans redeploiement. En cas de base injoignable, repli automatique sur le fichier.
CONTENT_SOURCE=

# Stockage des images televersees depuis le CMS (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Mesure d'audience (PostHog UE, relais t.theodelporte.fr)
# Cle publique du projet PostHog (phc_...) : visible dans chaque page, jamais la cle personnelle phx_.
# Figee au build : un changement n'a d'effet qu'apres un nouveau deploiement.
NEXT_PUBLIC_POSTHOG_KEY=
# "true" autorise la mesure sur localhost et *.vercel.app (previsualisation et test local).
# Ne jamais definir en Production.
NEXT_PUBLIC_ANALYTICS_ALLOW_PREVIEW=
